---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { AUTHOR_NAME, AUTHOR_ROLE, CONTACT_EMAIL, LAST_UPDATED, SITE_URL, SITE_NAMES, LEGAL, LANG_TAGS } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { displayDate } from '../../lib/format';
import { personSchema, organizationSchema, breadcrumbSchema, profilePageSchema, contactPageSchema } from '../../lib/seo';
const lang = 'en';
const upd = displayDate(LAST_UPDATED, LANG_TAGS[lang]);
---
<PageLayout title="Embed the Passport Cost and Arrival Date Calculator" description="Embed the US passport cost and arrival date calculator free by iframe: every fee split by payment, the arrival window and the official rule for your trip, in English or Spanish." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6"><h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the passport calculator</h1><p class="mt-3 text-lg text-navy-700">For libraries, county clerks, travel agencies and community groups: paste the code once, and fees and times update with each State Department change.</p></header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{`<iframe src="${SITE_URL}/embed/passport-cost/" title="Passport cost and arrival date calculator" width="100%" height="980" style="border:0;max-width:1100px" loading="lazy"></iframe>`}</code></pre>
    <p>Add <code>?lang=es</code> to the address for the Spanish version. Terms: the source link under the calculator stays visible and the calculator is not altered; it is provided without warranty. The frame stores and measures nothing.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/passport-cost/" title="Passport cost and arrival date calculator" width="100%" height="980" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
