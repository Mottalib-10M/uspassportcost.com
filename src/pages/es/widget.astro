---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { AUTHOR_NAME, AUTHOR_ROLE, CONTACT_EMAIL, LAST_UPDATED, SITE_URL, SITE_NAMES, LEGAL, LANG_TAGS } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { displayDate } from '../../lib/format';
import { personSchema, organizationSchema, breadcrumbSchema, profilePageSchema, contactPageSchema } from '../../lib/seo';
const lang = 'es';
const upd = displayDate(LAST_UPDATED, LANG_TAGS[lang]);
---
<PageLayout title="Inserte la calculadora de costo y fecha del pasaporte" description="Inserte gratis la calculadora del costo y la fecha de llegada del pasaporte de EE. UU. con un iframe: cada tarifa por pago, la ventana de llegada y la regla oficial, en español." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Inicio', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6"><h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Inserte la calculadora del pasaporte</h1><p class="mt-3 text-lg text-navy-700">Para bibliotecas, oficinas del condado, agencias de viaje y grupos comunitarios: pegue el código una vez y las tarifas y tiempos se actualizan con cada cambio del Departamento de Estado.</p></header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{`<iframe src="${SITE_URL}/embed/passport-cost/?lang=es" title="Calculadora de costo y fecha del pasaporte" width="100%" height="980" style="border:0;max-width:1100px" loading="lazy"></iframe>`}</code></pre>
    <p>Condiciones: el enlace de la fuente bajo la calculadora queda visible y la calculadora no se modifica; se ofrece sin garantía. El marco no guarda ni mide nada.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/passport-cost/?lang=es" title="Calculadora de costo y fecha del pasaporte" width="100%" height="980" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
